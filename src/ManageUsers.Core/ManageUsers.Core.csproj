<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings, paths and file-trust rules shared by manageusers.exe and the
       Managed Users Cleanup app, so both resolve settings the same way. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ManageUsers</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
