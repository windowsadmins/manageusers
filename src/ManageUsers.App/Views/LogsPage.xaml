<Page
    x:Class="ManageUsers.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ManageUsers.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Shared Toolbar Row ═══ -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    Padding="16,10" VerticalAlignment="Center">
            <TextBlock Text="Logs" Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="OpenEditorBtn" ToolTipService.ToolTip="Open in editor"
                        Click="OpenEditor_Click" Padding="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Open log folder"
                        Click="OpenFolder_Click" Padding="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Refresh" Click="Refresh_Click"
                        Padding="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    Padding="16,10" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE71C;" FontSize="14"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" PlaceholderText="Filter log..."
                     Width="300" TextChanged="FilterBox_TextChanged"
                     VerticalAlignment="Center" />
        </StackPanel>

        <MenuFlyoutSeparator Grid.Row="1" Grid.ColumnSpan="3" />

        <!-- ═══ Left: File List ═══ -->
        <ListView x:Name="LogFileList" Grid.Row="2" Grid.Column="0"
                  SelectionChanged="LogFileList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogFile">
                    <Grid Padding="4,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DisplaySize}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ Left: No-logs state ═══ -->
        <StackPanel x:Name="NoLogsState" Grid.Row="2" Grid.Column="0"
                    Padding="16,12" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="No logs yet" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="NoLogsPath" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ═══ Right: Log Content ═══ -->
        <Grid Grid.Row="2" Grid.Column="2">
            <ScrollViewer x:Name="LogScroller" Padding="12"
                          Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                <RichTextBlock x:Name="LogOutput" IsTextSelectionEnabled="True"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                               TextWrapping="Wrap" Padding="4,0" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE7C3;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="No Log Selected" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptySubtitle" Text="Select a log from the sidebar to view its contents."
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
