<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ManageUsers.App</RootNamespace>
    <AssemblyName>Managed Users Cleanup</AssemblyName>
    <Product>Managed Users Cleanup</Product>
    <Description>Managed Users Cleanup</Description>
    <ApplicationIcon>Assets\ManageUsers.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- PriGen needs the VS UWP workload; build.ps1 generates resources.pri with makepri.exe instead. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- Field-based [ObservableProperty]: the partial-property form fails with the WinUI XAML compiler. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManageUsers.Core\ManageUsers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ManageUsers.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ManageUsers.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
